{
  "name": "sea-openai-hackathon-2026",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:user",
    "dev:user": "next dev apps/user --port 3000",
    "dev:admin": "next dev apps/admin --port 3001",
    "dev:api": "node --import ./scripts/load-env.mjs ./node_modules/next/dist/bin/next dev apps/api --port 3002",
    "dev:application": "next dev apps/application --hostname localhost --port 3003",
    "build": "npm run build:user && npm run build:admin && npm run build:api && npm run build:application",
    "build:user": "next build apps/user",
    "build:admin": "next build apps/admin",
    "build:api": "node --import ./scripts/load-env.mjs ./node_modules/next/dist/bin/next build apps/api",
    "build:application": "next build apps/application",
    "start": "npm run start:user",
    "start:user": "next start apps/user --port 3000",
    "start:admin": "next start apps/admin --port 3001",
    "start:api": "node --import ./scripts/load-env.mjs ./node_modules/next/dist/bin/next start apps/api --port 3002",
    "start:application": "next start apps/application --port 3003",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p apps/user/tsconfig.json --noEmit && tsc -p apps/admin/tsconfig.json --noEmit && tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/application/tsconfig.json --noEmit",
    "test": "node --test",
    "seed:admin": "node scripts/seed-admin.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@openai/agents": "^0.17.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.5",
    "typescript": "^5.9.3"
  }
}
